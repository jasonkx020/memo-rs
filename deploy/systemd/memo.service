[Unit]
Description=Distributed Memo storage master node (no-ui)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=memo
Group=memo
# WorkingDirectory 不是数据目录；请在 settings.json 设置 data_dir（如 /var/lib/memo）
WorkingDirectory=/var/lib/memo
EnvironmentFile=-/etc/memo/memo.env
# 首次无身份时可去掉 --identity，仅靠 MEMO_LOGIN_PASSWORD 自动建存储节点
# 也可不传 --identity，由进程读取环境变量 MEMO_IDENTITY
ExecStart=/usr/local/bin/memo --no-ui
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
